# Production image for ghcr.io/pumacp/puma — the `puma` CLI.
# Separate from the repo-root Dockerfile (which is the docker-compose dev/runtime
# container, kept as-is). Multi-stage + slim + non-root for a small, safe image.
# Ollama is NOT bundled: run this alongside an Ollama service (see docker-compose.yml).

# Base image pinned by digest (D41): the floating tag resolved to a build with
# HIGH CVEs at the v4.0.0 release and the Trivy gate blocked the push. This is
# the python:3.11-slim multi-arch index for 3.11.18-slim-trixie as of
# 2026-10-31; refresh the digest (both stages) when Trivy reports new findings.
ARG PYTHON_BASE=python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60

# --- builder: produce a wheel ---
FROM ${PYTHON_BASE} AS builder
WORKDIR /build
RUN pip install --no-cache-dir build
COPY . .
RUN python -m build --wheel --outdir /dist

# --- final: clean install of the wheel + its dependencies ---
FROM ${PYTHON_BASE} AS final
LABEL org.opencontainers.image.title="PUMA" \
      org.opencontainers.image.description="Local, reproducible benchmarking of open LLMs on project management tasks" \
      org.opencontainers.image.source="https://github.com/pumacp/puma" \
      org.opencontainers.image.documentation="https://pumacp.github.io/puma" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 1000 puma
# The base image ships setuptools 79.0.1, whose vendored wheel 0.45.1 and
# jaraco.context 5.3.0 carry HIGH CVEs (CVE-2026-24049, CVE-2026-23949) that
# the Trivy gate rejects. setuptools >= 82 vendors fixed copies; 84.2.1 also
# drops pkg_resources, which no runtime dependency of PUMA imports.
RUN pip install --no-cache-dir --upgrade "setuptools==84.2.1"
COPY --from=builder /dist/*.whl /tmp/
RUN pip install --no-cache-dir /tmp/*.whl && rm -f /tmp/*.whl

USER puma
WORKDIR /home/puma
ENTRYPOINT ["puma"]
CMD ["--help"]
