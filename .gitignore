# Environment files
.env
*.env.local

# macOS
.DS_Store
.obsidian/*
!.obsidian/community-plugins.json
.obsidian/workspace.json
.trash/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
.venv/
venv/
env/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# type checkers / linters
.mypy_cache/
.ruff_cache/

# Datasets — CSVs are tracked (small, see data/README.md). Only the
# raw SQL dumps and generated parquet/json artifacts stay ignored.
# data/*.csv          ← commented: CSVs are tracked (see data/README.md)
# data/*.json         ← commented: same rationale
# data/*.parquet      ← commented: same rationale
!data/.gitkeep
!data/README.md

# Run outputs
results/*
!results/.gitkeep

# Legacy reports/ (superseded by src/puma/reporting/)
reports/

# Logs
logs/*
!logs/.gitkeep
*.log

# db/ folder is tracked (placeholder only) — large dumps must NOT be committed
# (GitHub blocks files >100 MB). Use scripts/download_datasets.py to populate.
db/*
!db/.gitkeep
!db/README.md

# Streamlit cache
.streamlit/cache/

# Carbon tracking
emissions.csv

# Docker / OS
.dockerignore

# IDE
.idea/
.vscode/
*.swp
*.swo
.gitnexus
docs/internal/

# GitNexus operational artifacts (auto-generated graph images, etc.)
assets/img/*GitNexus*

# Agent / AI tooling artifacts (environment, not project sources)
.claude/
AGENTS.md
CLAUDE.md
